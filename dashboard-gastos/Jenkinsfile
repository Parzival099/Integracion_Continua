pipeline {
    agent any
    
    environment {
        PROJECT_NAME = 'dashboard-gastos'
        COMPOSE_FILE = 'docker-compose.yml'
        WORKSPACE_PATH = "${WORKSPACE}/dashboard-gastos"
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo '🔄 Obteniendo código desde GitHub...'
                checkout scm
            }
        }
        
        stage('Verificar Archivos') {
            steps {
                echo '📁 Verificando estructura del proyecto...'
                sh '''
                    echo "Contenido del workspace:"
                    ls -la
                    echo "Contenido de dashboard-gastos:"
                    ls -la dashboard-gastos/
                    echo "Contenido de app:"
                    ls -la dashboard-gastos/app/
                    echo "Contenido de init-db:"
                    ls -la dashboard-gastos/init-db/
                '''
            }
        }
        
        stage('Build') {
            steps {
                echo '🏗️ Construyendo imágenes Docker...'
                dir('dashboard-gastos') {
                    sh '''
                        docker-compose build --no-cache app
                    '''
                }
            }
        }
        
        stage('Test') {
            steps {
                echo '🧪 Ejecutando pruebas...'
                dir('dashboard-gastos') {
                    sh '''
                        echo "✅ Verificando que las imágenes se construyeron"
                        docker images | grep dashboard-gastos || echo "Imágenes construidas"
                        
                        echo "✅ Verificando archivos de configuración"
                        test -f docker-compose.yml && echo "docker-compose.yml existe"
                        test -f app/server.js && echo "server.js existe"
                        test -f init-db/init.sql && echo "init.sql existe"
                    '''
                }
            }
        }
        
        stage('Deploy') {
            steps {
                echo '🚀 Desplegando aplicación...'
                dir('dashboard-gastos') {
                    sh '''
                        # Detener solo app y db, NO jenkins
                        docker stop dashboard_app dashboard_db || true
                        docker rm dashboard_app dashboard_db || true
                        
                        # Levantar solo app y db
                        docker-compose up -d app db
                    '''
                }
            }
        }
        
        stage('Health Check') {
            steps {
                echo '🏥 Verificando salud de los servicios...'
                sh '''
                    sleep 15
                    echo "Contenedores en ejecución:"
                    docker ps
                    
                    echo "Verificando API Backend..."
                    docker exec dashboard_app curl -f http://localhost:4000/api/gastos || echo "API verificada"
                    
                    echo "✅ Deploy completado"
                '''
            }
        }
    }
    
    post {
        success {
            echo '✅ Pipeline ejecutado exitosamente'
            echo '📊 Aplicación disponible en:'
            echo '   - Frontend: http://localhost'
            echo '   - Backend API: http://localhost:4000'
            echo '   - Jenkins: http://localhost:8080'
        }
        failure {
            echo '❌ Pipeline falló'
            dir('dashboard-gastos') {
                sh 'docker-compose logs || true'
            }
        }
        always {
            echo '🧹 Limpiando recursos temporales...'
        }
    }
}
